digraph G { rankdir=LR; nodesep=0.9; ranksep=1.3; fontname="DejaVu Sans"; node [shape=plain fontname="DejaVu Sans" fontsize=11]; edge [fontname="DejaVu Sans" fontsize=11 arrowhead=none];
labelloc=t; label=<<B>Diagrama de Classes - Logística Express</B>>;
Funcionario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFCC"><TR><TD BGCOLOR="#FFE680"><B>Funcionario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">- codFuncionario : int</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- nome : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- email : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- senha : String (hash bcrypt)</TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">+ login(email, senha) : Token</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ logout() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ cadastrar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ listar() : List</TD></TR></TABLE>>];
Motorista [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFCC"><TR><TD BGCOLOR="#FFE680"><B>Motorista</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">- codMotorista : int</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- nome : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- cnh : String (criptografada)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- cpf : String (criptografado)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- telefone : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">+ cadastrar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ atualizar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ apagar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ consultar() : Object</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ listar() : List</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ buscarPorNome(nome) : List</TD></TR></TABLE>>];
Carga [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFCC"><TR><TD BGCOLOR="#FFE680"><B>Carga</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">- codCarga : int</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- descricao : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- peso : float</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- volume : float</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- codigoRastreio : long (11 dígitos)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- codigoMotorista : int</TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">+ cadastrar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ atualizar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ apagar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ consultar() : Object</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ listar() : List</TD></TR></TABLE>>];
Entrega [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFCC"><TR><TD BGCOLOR="#FFE680"><B>Entrega</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">- codEntrega : int</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- cidadeDestino : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- status : {ENTREGUE, TRANSITO}</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- data : Date</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- hora : Time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- idCarga : int</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- idFuncionario : int</TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">+ cadastrar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ atualizar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ apagar() : void</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ consultar() : Object</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ listar() : List</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ filtrarPorData(ordem) : List</TD></TR></TABLE>>];
Motorista -> Carga [taillabel="1" headlabel="0..*" labeldistance=3 label="  possui  "];
Carga -> Entrega [taillabel="1" headlabel="0..1" labeldistance=3 label="  gera  "];
Funcionario -> Entrega [taillabel="1" headlabel="0..*" labeldistance=3 label="  registra  "];
}
