# Copie para .env e ajuste
PORT=3000
HOST=0.0.0.0
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_logistica
DB_USER=root
DB_PASS=senai
# Troque estes segredos em produção (mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-jwt-por-um-valor-longo-e-aleatorio
CHAVE_CRIPTO=troque-esta-chave-aes-por-um-valor-longo-e-aleatorio
# true = só aceita acessos de IPs da rede interna (10.x, 172.16-31.x, 192.168.x, localhost)
REDE_INTERNA=true
